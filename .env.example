# JanSamadhan environment variables
# Copy to `.dev.vars` (Wrangler/Workers local dev) or `.env` and fill in real values.
# NEVER commit real credentials. In production set these as Worker secrets, e.g.
#   npx wrangler secret put SMTP_PASSWORD

# ---------------------------------------------------------------------------
# Email OTP (server-side). Ported from FOC PROJECT's Gmail SMTP mechanism.
# ---------------------------------------------------------------------------

# REQUIRED. Random secret (>= 32 chars) used to HMAC-hash OTPs before storage.
# Generate with: openssl rand -hex 32
OTP_SECRET=

# SMTP server. Defaults target Gmail with STARTTLS on port 587 (same as FOC PROJECT).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (port 587) | tls (implicit TLS, port 465) | none (local testing only)
SMTP_SECURITY=starttls

# REQUIRED. Sender account. For Gmail use a 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_USER=
SMTP_PASSWORD=
# Legacy FOC PROJECT names are also accepted if SMTP_USER/SMTP_PASSWORD are unset:
# SENDER_EMAIL=
# SENDER_APP_PASSWORD=

# Optional: "From" address/name shown in the email (defaults to SMTP_USER / JanSamadhan).
OTP_FROM_EMAIL=
OTP_FROM_NAME=JanSamadhan
SMTP_TIMEOUT_MS=15000

# OTP policy (optional; defaults shown)
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_MAX_SENDS_PER_HOUR=8
OTP_MAX_SENDS_PER_IP_PER_HOUR=30

# ---------------------------------------------------------------------------
# Existing integrations
# ---------------------------------------------------------------------------
MAPPLS_ACCESS_TOKEN=
